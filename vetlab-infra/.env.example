# ---------------------------------------------------------------------------
# Template de variáveis de ambiente do VET-Lab.
# Copie para .env (`cp .env.example .env`) e preencha as senhas.
#
# O .env NÃO é versionado e o compose se recusa a subir com senha vazia.
# Gere uma senha diferente por role:
#   openssl rand -base64 24        # Linux, macOS, WSL ou Git Bash
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})   # PowerShell
#
# Depois de trocar as senhas, rode `docker compose down -v && docker compose up -d`
# se o volume já existia (as senhas são gravadas na criação do cluster).
# ---------------------------------------------------------------------------

# --- Imagem / cluster -------------------------------------------------------
POSTGRES_MAJOR=18
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_INITDB_ARGS="--encoding=UTF8 --locale=C.UTF-8 --data-checksums"

# --- TLS (certificado autoassinado gerado no primeiro start) ----------------
POSTGRES_SSL_SUBJECT=/CN=localhost
POSTGRES_SSL_SAN=DNS:localhost,DNS:postgres,DNS:pgbouncer,IP:127.0.0.1
POSTGRES_SSL_DAYS=3650

# --- Banco e roles da aplicação --------------------------------------------
SVC_DB_NAME=vetlab_db
SVC_DB_USER=svc_app
SVC_DB_PASSWORD=
SVC_DB_READONLY_USER=svc_readonly
SVC_DB_READONLY_PASSWORD=

# --- PgBouncer (pool transacional) -----------------------------------------
PGBOUNCER_PORT=6432

# --- pgAdmin ----------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@localhost.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# --- Operação ---------------------------------------------------------------
BACKUP_RETENTION_DAYS=7
TZ=America/Sao_Paulo
